{
  "name": "calendario-13-lunas",
  "version": "1.8.0",
  "description": "Calendario de las 13 Lunas - Mari Küla Küyen - Penco, Bío-Bío, Chile",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:win-nsis": "electron-builder --win nsis",
    "build": "electron-builder --win portable",
    "movil:sync": "cap sync android",
    "movil:apk": "cap sync android && cd android && gradlew assembleDebug",
    "movil:build": "npm run sync:web -- --fix && cap sync android && cd android && gradlew assembleDebug",
    "check:manifest": "node scripts/sync-manifest.cjs",
    "sync:manifest": "node scripts/sync-manifest.cjs --fix",
    "build:sw": "node scripts/build-sw.cjs --fix",
    "check:sw": "node scripts/build-sw.cjs",
    "build:min": "node scripts/minify.cjs --fix",
    "check:min": "node scripts/minify.cjs --check",
    "build:tpl": "node scripts/build-templates.cjs --fix",
    "check:tpl": "node scripts/build-templates.cjs --check",
    "csp:fase2": "node scripts/csp-fase2.cjs --fix",
    "check:csp2": "node scripts/csp-fase2.cjs --check",
    "check:perf": "node scripts/perf-budget.cjs",
    "lighthouse": "node scripts/lighthouse-ci.cjs",
    "check:donate": "node scripts/check-donate.cjs",
    "check:web": "node scripts/sync-web.cjs",
    "sync:web": "node scripts/sync-web.cjs --fix",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:size": "node scripts/check-size.cjs",
    "lint:commits": "node scripts/lint-commits.cjs",
    "test": "npm run csp:fase2 && npm run build:tpl && npm run build:min && node --test \"tests/*.test.js\" && npm run check:csp2 && npm run check:tpl && npm run check:min && npm run check:perf && npm run check:manifest && npm run check:sw && npm run check:web && npm run check:donate && npm run check:syntax"
  },
  "license": "GPL-3.0-or-later",
  "author": "Semillero Consciente <semilleroconsciente@gmail.com>",
  "licenses": [
    {
      "type": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    },
    {
      "type": "CC-BY-NC-SA-4.0 (contenido creativo: diseño, textos, ilustraciones)",
      "url": "https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es"
    }
  ],
  "type": "commonjs",
  "build": {
    "appId": "cl.penco.calendario13lunas",
    "productName": "Calendario 13 Lunas",
    "directories": {
      "output": "dist-empaquetado"
    },
    "files": [
      "COPYING",
      "LICENSE.md",
      "LICENCIA-CONTENIDO-CC-BY-NC-SA-4.0.md",
      "main.js",
      "preload.js",
      "index.html",
      "boot-modulos.js",
      "sw-registro.js",
      "data/territorios/**/*",
      "sw.js",
      "manifest.json",
      "_headers",
      "donate.json",
      "icon.ico",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png",
      "templates/*.html",
      "screenshots/*.png",
      "min/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "semilleroconsciente",
        "repo": "calendario-13-lunas"
      }
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.x",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "electron-updater": "^6.8.9"
  }
}
