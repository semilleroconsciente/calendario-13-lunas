{
  "name": "calendario-13-lunas",
  "version": "1.1.3",
  "description": "Calendario de las 13 Lunas - Mari Küla Küyen - Penco, Bío-Bío, Chile",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build": "electron-builder --win portable"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "cl.penco.calendario13lunas",
    "productName": "Calendario 13 Lunas",
    "directories": {
      "output": "dist-empaquetado"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "astro.js",
      "cal.js",
      "data.js",
      "frases.js",
      "donate.json",
      "icon.ico"
    ],
    "win": {
      "target": ["portable"],
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.x"
  }
}
