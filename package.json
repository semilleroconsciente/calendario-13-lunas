{
  "name": "calendario-13-lunas",
  "version": "1.1.3",
  "description": "Calendario de las 13 Lunas - Mari Küla Küyen - Penco, Bío-Bío, Chile",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build": "electron-builder --win portable"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "cl.penco.calendario13lunas",
    "productName": "Calendario 13 Lunas",
    "directories": {
      "output": "dist-empaquetado"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "web-api.js",
      "astro.js",
      "cal.js",
      "data.js",
      "frases.js",
      "renderer.js",
      "nuevos-modulos.js",
      "linaje-modulos.js",
      "eneagrama-modulo.js",
      "carta-astral.js",
      "voz-abuelos.js",
      "penco-guia.js",
      "bosque-historia.js",
      "bosque-semillero.js",
      "aves-historia.js",
      "pesca-historia.js",
      "semillero-guias.js",
      "ajedrez-modulo.js",
      "sudoku-modulo.js",
      "info-clave.js",
      "psicologia-modulo.js",
      "adolescencia-modulo.js",
      "sw.js",
      "manifest.json",
      "donate.json",
      "icon.ico",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png",
      "assets/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.x"
  }
}
